# Copy to .env.local for local dev. These same names must also exist as
# GitHub repository secrets, because NEXT_PUBLIC_* values are baked into the
# bundle at build time (see .github/workflows/deploy.yml).

# Google Drive photo gallery. Restrict this key to the Drive API and to the
# site's referrer: it is readable by anyone who views source.
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_ID=

# Contact form (emailjs.com). The "public key" is meant to be public; lock the
# service to your domain in the EmailJS dashboard.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
